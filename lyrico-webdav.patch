@@ -0,0 +1,165 @@
+package com.lonx.lyrico.data.webdav
+
+import android.util.Log
+import com.lonx.lyrico.data.model.SongFile
+import com.lonx.lyrico.data.model.entity.FolderEntity
+import com.lonx.lyrico.data.model.log.AppLog
+import com.lonx.lyrico.data.model.log.AppLogLevel
+import com.lonx.lyrico.data.model.log.AppLogType
+import java.util.Locale
+import kotlin.math.abs
+
+/** 一次 WebDAV 扫描的结果，字段含义与 SafScanResult 对齐，便于扫描仓库统一处理。 */
+data class WebDavScanResult(
+    val songs: List<WebDavScannedSongFile>,
+    val successfulFolderIds: Set<Long>,
+    val failedFolderIds: Set<Long>,
+    val missingFolderIds: Set<Long>,
+)
+
+data class WebDavScannedSongFile(
+    val songFile: SongFile,
+    val rootFolderId: Long,
+    val folderPath: String,
+)
+
+/**
+ * WebDAV 目录遍历器。
+ *
+ * 与 SAF 扫描器保持同一套语义：返回虚拟 mediaId、绝对展示路径、目录级 folderPath，
+ * 上层扫描仓库无需区分来源即可写入同一张 songs 表。
+ */
+class WebDavScanner(
+    private val configStore: WebDavConfigStore,
+    private val clientFactory: WebDavClientFactory,
+) {
+    suspend fun scanFolders(folders: List<FolderEntity>): WebDavScanResult {
+        val songs = mutableListOf<WebDavScannedSongFile>()
+        val successful = mutableSetOf<Long>()
+        val failed = mutableSetOf<Long>()
+        val missing = mutableSetOf<Long>()
+        val visited = mutableSetOf<String>()
+
+        for (folder in folders) {
+            val treeUri = folder.treeUri
+            val parsed = WebDavUri.parseRootUri(treeUri)
+            if (parsed == null) {
+                failed += folder.id
+                continue
+            }
+            val config = configStore.get(parsed.connectionId)
+            if (config == null) {
+                // 连接已被删除，视为根目录已失效，避免残留歌曲占着列表
+                missing += folder.id
+                continue
+            }
+            val client = clientFactory.byConfig(config)
+
+            try {
+                // 可达性判定：网络/认证失败一律记失败；只有环境明确可达、
+                // 但根目录 404 时才认为目录被移走，避免一次断网清空整个库。
+                try {
+                    client.resolveRootPath()
+                } catch (e: Exception) {
+                    if (e is kotlinx.coroutines.CancellationException) throw e
+                    failed += folder.id
+                    continue
+                }
+                if (!client.rootExists()) {
+                    missing += folder.id
+                    continue
+                }
+
+                walk(
+                    client = client,
+                    config = config,
+                    displayRootPath = folder.path,
+                    rootFolderId = folder.id,
+                    output = songs,
+                    visited = visited,
+                )
+                successful += folder.id
+            } catch (e: Exception) {
+                if (e is kotlinx.coroutines.CancellationException) throw e
+                Log.e(TAG, "扫描 WebDAV 文件夹失败: ${folder.path}", e)
+                AppLog.record(
+                    AppLogType.APP, TAG, "WebDAV scan root failed",
+                    "path=${folder.path}\ntreeUri=$treeUri\n${e::class.java.simpleName}: ${e.message}",
+                    treeUri, AppLogLevel.ERROR, e,
+                )
+                failed += folder.id
+            }
+        }
+
+        return WebDavScanResult(songs, successful, failed, missing)
+    }
+
+    private suspend fun walk(
+        client: WebDavClient,
+        config: WebDavConfig,
+        displayRootPath: String,
+        rootFolderId: Long,
+        output: MutableList<WebDavScannedSongFile>,
+        visited: MutableSet<String>,
+    ) {
+        val stack = ArrayDeque<String>()
+        stack.addLast("")
+
+        while (stack.isNotEmpty()) {
+            val currentRelative = stack.removeLast()
+            val children = client.propfind(currentRelative, depth = 1)
+
+            for (child in children) {
+                if (child.name.isBlank()) continue
+                if (child.isDirectory) {
+                    if (shouldSkipDirectory(child.name)) continue
+                    stack.addLast(child.relativePath)
+                    continue
+                }
+                if (!WebDavClient.isAudioFile(child.name)) continue
+
+                val key = "${config.id}|${child.relativePath}"
+                if (!visited.add(key)) continue
+
+                val absolutePath = buildDisplayPath(displayRootPath, child.relativePath)
+                val displayFolder = absolutePath.substringBeforeLast('/', missingDelimiterValue = displayRootPath)
+                output += WebDavScannedSongFile(
+                    songFile = SongFile(
+                        mediaId = virtualMediaId(key),
+                        uri = WebDavUri.buildFileUri(config.id, child.relativePath).toSafeUri(),
+                        filePath = absolutePath,
+                        fileName = child.name,
+                        lastModified = child.lastModified,
+                        dateAdded = child.lastModified,
+                        duration = 0L,
+                        fileSize = child.size,
+                    ),
+                    rootFolderId = rootFolderId,
+                    folderPath = displayFolder,
+                )
+            }
+        }
+    }
+
+    private fun String.toSafeUri(): android.net.Uri = android.net.Uri.parse(this)
+
+    private fun buildDisplayPath(rootPath: String, relativePath: String): String =
+        "${rootPath.trimEnd('/')}/${relativePath.trimStart('/')}"
+
+    private fun shouldSkipDirectory(name: String): Boolean {
+        val normalized = name.lowercase(Locale.ROOT)
+        return normalized.startsWith(".") ||
+            normalized == "@eadir" ||
+            normalized == "#recycle" ||
+            normalized == "#snapshot"
+    }
+
+    private fun virtualMediaId(key: String): Long {
+        val hash = key.hashCode().toLong()
+        return -abs(hash).coerceAtLeast(1L)
+    }
+
+    private companion object {
+        const val TAG = "WebDavScanner"
+    }
+}
