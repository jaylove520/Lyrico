@@ -0,0 +1,103 @@
+package com.lonx.lyrico.data.webdav
+
+import android.content.SharedPreferences
+import androidx.core.content.edit
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+@Serializable
+data class WebDavConfig(
+    val id: String,
+    val serverUrl: String,
+    val userName: String,
+    val password: String,
+    val basePath: String = "/",
+) {
+    /** 只用于日志与 UI，不包含密码。 */
+    override fun toString(): String = "WebDavConfig(id=$id, url=$serverUrl, user=$userName, path=$basePath)"
+}
+
+/**
+ * WebDAV 连接配置存储。凭据放在应用私有 SharedPreferences 中，
+ * 没有走 Room，避免凭据进入可导出的数据库/日志备份。
+ */
+class WebDavConfigStore(private val prefs: SharedPreferences) {
+
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+    private val changes = MutableStateFlow(prefs.getLong(KEY_VERSION, 0L))
+
+    val versionFlow = changes.map { prefs.getLong(KEY_VERSION, 0L) }
+
+    fun all(): List<WebDavConfig> {
+        val raw = prefs.getString(KEY_ITEMS, null) ?: return emptyList()
+        return runCatching {
+            json.decodeFromString<List<WebDavConfig>>(raw)
+        }.getOrDefault(emptyList())
+    }
+
+    fun get(id: String?): WebDavConfig? = id?.let { target -> all().firstOrNull { it.id == target } }
+
+    fun getByRootUri(rootUri: String?): WebDavConfig? {
+        val id = WebDavUri.parseRootUri(rootUri)?.connectionId ?: return null
+        return get(id)
+    }
+
+    fun save(config: WebDavConfig): WebDavConfig {
+        val normalized = config.copy(id = config.id.ifBlank { newId() })
+        val items = all().toMutableList()
+        val index = items.indexOfFirst { it.id == normalized.id }
+        if (index >= 0) items[index] = normalized else items.add(normalized)
+        write(items)
+        return normalized
+    }
+
+    fun delete(id: String) {
+        write(all().filterNot { it.id == id })
+    }
+
+    fun newId(): String = "wd" + System.currentTimeMillis().toString(36) +
+        Integer.toHexString((0..0xFFFF).random())
+
+    private fun write(items: List<WebDavConfig>) {
+        prefs.edit(commit = true) {
+            putString(KEY_ITEMS, json.encodeToString(items))
+            putLong(KEY_VERSION, System.currentTimeMillis())
+        }
+        changes.value = System.currentTimeMillis()
+    }
+
+    private companion object {
+        const val KEY_ITEMS = "webdav_connections"
+        const val KEY_VERSION = "webdav_version"
+    }
+}
+
+/**
+ * 连接缓存：按配置内容缓存 WebDavClient，避免每次 URL 解析都重建 OkHttp 连接池。
+ */
+class WebDavClientFactory(private val store: WebDavConfigStore) {
+
+    private val cache = LinkedHashMap<String, WebDavClient>()
+
+    fun byConfig(config: WebDavConfig): WebDavClient = synchronized(cache) {
+        val key = "${config.serverUrl}|${config.userName}|${config.password}|${config.basePath}"
+        cache[key] ?: WebDavClient(
+            serverUrl = config.serverUrl,
+            userName = config.userName,
+            password = config.password,
+            basePath = config.basePath,
+        ).also {
+            if (cache.size > 8) cache.remove(cache.keys.first())
+            cache[key] = it
+        }
+    }
+
+    /** 从歌曲 uri（lyricowebdav://<connectionId>/<相对路径>）解析客户端与相对路径。 */
+    fun resolve(uriString: String): Pair<WebDavClient, String>? {
+        val parsed = WebDavUri.parseFileUri(uriString) ?: return null
+        val config = store.get(parsed.connectionId) ?: return null
+        return byConfig(config) to parsed.relativePath
+    }
+}
