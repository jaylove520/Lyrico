+/**
+ * WebDAV 目录添加向导。
+ *
+ * 三步：填连接 → 测试并浏览 → 选定目录加入库。
+ * 这里的“选定目录”就是文件夹管理里的一个根，后续扫描、改标签都基于它，
+ * 与本地 SAF 文件夹地位相同。
+ */
+@Composable
+fun WebDavSetupDialog(
+    onDismiss: () -> Unit,
+    onFolderSelected: (connectionId: String, basePath: String, displayPath: String) -> Unit,
+) {
+    val viewModel: WebDavSetupViewModel = koinViewModel()
+    val state by viewModel.state.collectAsStateWithLifecycle()
+
+    Column(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        if (state.connectionId == null) {
+            OutlinedTextField(
+                value = state.serverUrl,
+                onValueChange = viewModel::updateServerUrl,
+                label = { Text("服务器地址") },
+                placeholder = { Text("https://nas.example.com:5006 或 /dav") },
+                singleLine = true,
+                modifier = Modifier.fillMaxWidth(),
+            )
+            Spacer(Modifier.height(8.dp))
+            OutlinedTextField(
+                value = state.userName,
+                onValueChange = viewModel::updateUserName,
+                label = { Text("用户名") },
+                singleLine = true,
+                modifier = Modifier.fillMaxWidth(),
+            )
+            Spacer(Modifier.height(8.dp))
+            OutlinedTextField(
+                value = state.password,
+                onValueChange = viewModel::updatePassword,
+                label = { Text("密码") },
+                singleLine = true,
+                visualTransformation = PasswordVisualTransformation(),
+                modifier = Modifier.fillMaxWidth(),
+            )
+            Spacer(Modifier.height(12.dp))
+            TextButton(
+                text = if (state.isLoading) "连接中…" else "测试连接",
+                onClick = viewModel::connect,
+                enabled = state.canConnect,
+                modifier = Modifier.fillMaxWidth(),
+                colors = ButtonDefaults.textButtonColorsPrimary(),
+            )
+        } else {
+            // 目录浏览：只列目录，避免把整个音乐库拉一遍
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                TextButton(
+                    text = if (state.browsePath.isEmpty()) "根目录" else ".. ${state.browsePath.substringAfterLast('/')}",
+                    onClick = {
+                        if (state.browsePath.isEmpty()) {
+                            viewModel.connect()
+                        } else {
+                            viewModel.goUp()
+                        }
+                    },
+                )
+                Spacer(Modifier.weight(1f))
+                if (state.isLoading) CircularProgressIndicator(Modifier.width(20.dp))
+            }
+            LazyColumn(Modifier.weight(1f, fill = false).height(260.dp)) {
+                items(state.entries, key = { it.relativePath.ifBlank { it.name } }) { entry ->
+                    Row(
+                        Modifier
+                            .fillMaxWidth()
+                            .clickable { viewModel.openDirectory(entry.relativePath) }
+                            .padding(vertical = 10.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        Icon(
+                            imageVector = LucideIcons.Folder,
+                            contentDescription = null,
+                            tint = MiuixTheme.colorScheme.primary,
+                        )
+                        Spacer(Modifier.width(12.dp))
+                        Text(entry.name, fontSize = 15.sp, maxLines = 1)
+                    }
+                }
+            }
+            Text(
+                text = "当前选择：${state.browsePath.ifBlank { "/" }}",
+                fontSize = 12.sp,
+                color = MiuixTheme.colorScheme.onSurfaceVariantSummary,
+                modifier = Modifier.padding(vertical = 6.dp),
+            )
+            TextButton(
+                text = "添加此目录",
+                onClick = {
+                    viewModel.saveConnection()?.let { saved ->
+                        onFolderSelected(saved.connectionId, saved.basePath, saved.displayPath)
+                        onDismiss()
+                    }
+                },
+                modifier = Modifier.fillMaxWidth(),
+                colors = ButtonDefaults.textButtonColorsPrimary(),
+            )
+        }
+
+        state.statusMessage?.let { message ->
+            Spacer(Modifier.height(8.dp))
+            Text(
+                text = message,
+                fontSize = 12.sp,
+                color = if (state.isError) MiuixTheme.colorScheme.error
+                else MiuixTheme.colorScheme.onSurfaceVariantSummary,
+            )
+        }
+
+        Row(Modifier.fillMaxWidth().padding(top = 12.dp), horizontalArrangement = Arrangement.End) {
+            TextButton(text = "取消", onClick = onDismiss)
+        }
+    }
+}
