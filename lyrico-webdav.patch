@@ -0,0 +1,75 @@
+package com.lonx.lyrico.data.webdav
+
+/**
+ * Lyrico 的 WebDAV 虚拟 URI 方案。
+ *
+ * 目录根： lyricowebdav-tree://<connectionId>/?path=/Music
+ * 文件：   lyricowebdav://<connectionId>/<相对扫描根的路径>
+ *
+ * 用自定义 scheme 而不是 http(s)，是为了让整个库的读写链路可以一眼识别出
+ * “这是远程文件”，不会被误当成普通网络链接或 MediaStore 条目处理。
+ */
+object WebDavUri {
+
+    const val FILE_SCHEME = "lyricowebdav"
+    const val TREE_SCHEME = "lyricowebdav-tree"
+
+    private const val QUERY_PATH = "path"
+
+    data class Parsed(val connectionId: String, val relativePath: String)
+
+    /** treeUri：注册到 folders 表的根标识。 */
+    fun buildRootUri(connectionId: String, basePath: String): String {
+        val path = WebDavClient.normalizeRelative(basePath)
+        return "$TREE_SCHEME://$connectionId/" +
+            (if (path.isEmpty()) "" else "?$QUERY_PATH=/" + encodeQuery(path))
+    }
+
+    fun parseRootUri(uriString: String?): Parsed? {
+        if (uriString.isNullOrBlank()) return null
+        val schemePrefix = "$TREE_SCHEME://"
+        if (!uriString.startsWith(schemePrefix)) return null
+        val rest = uriString.removePrefix(schemePrefix)
+        val connectionId = rest.substringBefore('/').substringBefore('?')
+        if (connectionId.isBlank()) return null
+        val query = rest.substringAfter('?', "")
+        val basePath = query
+            .split('&')
+            .firstOrNull { it.startsWith("$QUERY_PATH=") }
+            ?.substringAfter('=')
+            ?.let { decodeQuery(it) }
+            .orEmpty()
+        return Parsed(connectionId, WebDavClient.normalizeRelative(basePath))
+    }
+
+    /** 文件 uri：歌曲记录的 uri 字段。 */
+    fun buildFileUri(connectionId: String, relativePath: String): String {
+        val encoded = WebDavClient.normalizeRelative(relativePath)
+            .split('/')
+            .joinToString("/") { WebDavClient.encodePathSegment(it) }
+        return "$FILE_SCHEME://$connectionId/$encoded"
+    }
+
+    fun parseFileUri(uriString: String): Parsed? {
+        if (!uriString.startsWith("$FILE_SCHEME://")) return null
+        val rest = uriString.removePrefix("$FILE_SCHEME://")
+        val connectionId = rest.substringBefore('/')
+        if (connectionId.isBlank()) return null
+        val path = rest.substringAfter('/', "")
+        return Parsed(connectionId, WebDavClient.normalizeRelative(WebDavClient.decodePath(path)))
+    }
+
+    /** folders.treeUri 表示 WebDAV 根目录时返回对应的连接信息。 */
+    fun treeRoot(uriString: String?): Parsed? = parseRootUri(uriString)
+
+    fun isWebDavUri(uriString: String?): Boolean =
+        uriString != null && (uriString.startsWith("$FILE_SCHEME://") || uriString.startsWith("$TREE_SCHEME://"))
+
+    private fun encodeQuery(value: String): String =
+        value.split('/').filter { it.isNotBlank() }.joinToString("/") {
+            WebDavClient.encodePathSegment(it)
+        }
+
+    private fun decodeQuery(value: String): String =
+        WebDavClient.decodePath(value)
+}
