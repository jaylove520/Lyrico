+package com.lonx.lyrico.data.model.dao
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.OnConflictStrategy
+import androidx.room.Query
+import androidx.room.Transaction
+import com.lonx.lyrico.data.model.entity.ScanJournalEntity
+import com.lonx.lyrico.data.model.entity.ScanJournalItemEntity
+import com.lonx.lyrico.data.model.entity.ScanJournalItemStatus
+import com.lonx.lyrico.data.model.entity.ScanJournalStatus
+import kotlinx.coroutines.flow.Flow
+
+@Dao
+interface ScanJournalDao {
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsertJournal(journal: ScanJournalEntity)
+
+    @Query("SELECT * FROM scan_journals WHERE journalId = :journalId")
+    suspend fun getJournal(journalId: String): ScanJournalEntity?
+
+    @Query("""
+        SELECT * FROM scan_journals
+        WHERE status IN ('RUNNING', 'PAUSED')
+        ORDER BY updatedAt DESC
+        LIMIT 1
+    """)
+    suspend fun getResumableJournal(): ScanJournalEntity?
+
+    @Query("SELECT * FROM scan_journals ORDER BY createdAt DESC LIMIT 20")
+    fun observeRecentJournals(): Flow<List<ScanJournalEntity>>
+
+    @Query("""
+        UPDATE scan_journals SET
+            totalFiles = :totalFiles,
+            processedFiles = :processed,
+            insertedCount = :inserted,
+            updatedCount = :updated,
+            failedCount = :failed,
+            skippedCount = :skipped,
+            currentStage = :stage,
+            currentFile = :currentFile,
+            updatedAt = :now
+        WHERE journalId = :journalId
+    """)
+    suspend fun updateProgress(
+        journalId: String,
+        totalFiles: Int,
+        processed: Int,
+        inserted: Int,
+        updated: Int,
+        failed: Int,
+        skipped: Int,
+        stage: String?,
+        currentFile: String?,
+        now: Long = System.currentTimeMillis(),
+    )
+
+    @Query("""
+        UPDATE scan_journals
+        SET status = :status, lastError = :error, finishedAt = :finishedAt, updatedAt = :now
+        WHERE journalId = :journalId
+    """)
+    suspend fun updateStatus(
+        journalId: String,
+        status: String,
+        error: String? = null,
+        finishedAt: Long? = null,
+        now: Long = System.currentTimeMillis(),
+    )
+
+    @Insert(onConflict = OnConflictStrategy.REPLACE)
+    suspend fun upsertItem(item: ScanJournalItemEntity)
+
+    @Transaction
+    suspend fun recordItem(item: ScanJournalItemEntity) {
+        upsertItem(item)
+    }
+
+    @Query("SELECT uri FROM scan_journal_items WHERE journalId = :journalId AND status = 'done'")
+    suspend fun getCompletedUris(journalId: String): List<String>
+
+    @Query("SELECT COUNT(*) FROM scan_journal_items WHERE journalId = :journalId AND status = 'done'")
+    suspend fun countCompleted(journalId: String): Int
+
+    @Query("DELETE FROM scan_journal_items WHERE journalId = :journalId")
+    suspend fun clearItems(journalId: String)
+
+    @Query("DELETE FROM scan_journals WHERE journalId = :journalId")
+    suspend fun deleteJournal(journalId: String)
+
+    @Transaction
+    suspend fun deleteJournalWithItems(journalId: String) {
+        clearItems(journalId)
+        deleteJournal(journalId)
+    }
+
+    /** 清理过旧的工作日志，避免无限增长。 */
+    @Transaction
+    suspend fun pruneOldJournals(keepCount: Int = 5) {
+        val old = getOldFinishedJournalIds(keepCount)
+        old.forEach { deleteJournalWithItems(it) }
+    }
+
+    @Query("""
+        SELECT journalId FROM scan_journals
+        WHERE status IN ('FINISHED', 'FAILED')
+        ORDER BY createdAt DESC
+        LIMIT -1 OFFSET :keepCount
+    """)
+    suspend fun getOldFinishedJournalIds(keepCount: Int): List<String>
+
+    /**
+     * 标记为完成时保留已处理条目，方便用户查看本次扫描跳过了哪些文件；
+     * 只有超过保留数量的旧日志才会连条目一起删除。
+     */
+    @Query("""
+        SELECT COUNT(*) FROM scan_journal_items
+        WHERE journalId = :journalId AND status IN ('failed', 'skipped')
+    """)
+    suspend fun countProblemItems(journalId: String): Int
+
+    @Query("UPDATE scan_journal_items SET status = :status WHERE journalId = :journalId AND status = 'failed'")
+    suspend fun resetFailedItems(journalId: String, status: String = ScanJournalItemStatus.DONE)
+
+    @Query("SELECT * FROM scan_journal_items WHERE journalId = :journalId AND status != 'done'")
+    suspend fun getProblemItems(journalId: String): List<ScanJournalItemEntity>
+
+    @Query("UPDATE scan_journals SET status = 'PAUSED', updatedAt = :now WHERE status = 'RUNNING'")
+    suspend fun markAllRunningAsPaused(now: Long = System.currentTimeMillis())
+}
+
+/** 供 UI 判断是否还有可续作的扫描。 */
+suspend fun ScanJournalDao.resumableOrNull(): ScanJournalEntity? =
+    getResumableJournal()?.takeIf { it.status == ScanJournalStatus.RUNNING || it.status == ScanJournalStatus.PAUSED }
