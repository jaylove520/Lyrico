+package com.lonx.lyrico.data.model.entity
+
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+
+/**
+ * 一次库扫描的持久化工作日志。
+ *
+ * 远程（WebDAV）库可能包含上千首文件，单次扫描耗时可达数十分钟。
+ * 用户中途退出、切网、熄屏被杀都很常见，没有工作日志就只能从头再来，
+ * 已经下载并解析过的标签全部作废。这张表记录扫描进度与每个文件的处理结果，
+ * 再次启动时据此跳过已完成的部分。
+ */
+@Entity(
+    tableName = "scan_journals",
+    indices = [Index("status"), Index("createdAt")]
+)
+data class ScanJournalEntity(
+    @PrimaryKey val journalId: String,
+
+    /** 扫描范围：null 表示全库，否则是逗号分隔的根文件夹 id。 */
+    val scopeFolderIds: String?,
+
+    /** RUNNING / PAUSED / FINISHED / FAILED */
+    val status: String,
+
+    val fullRescan: Boolean,
+
+    /** 枚举阶段发现的总文件数，-1 表示尚未枚举完成。 */
+    val totalFiles: Int = -1,
+
+    /** 已处理文件数（含跳过与失败）。 */
+    val processedFiles: Int = 0,
+
+    val insertedCount: Int = 0,
+
+    val updatedCount: Int = 0,
+
+    val failedCount: Int = 0,
+
+    val skippedCount: Int = 0,
+
+    val currentStage: String? = null,
+
+    val currentFile: String? = null,
+
+    val lastError: String? = null,
+
+    val createdAt: Long = System.currentTimeMillis(),
+
+    val updatedAt: Long = System.currentTimeMillis(),
+
+    val finishedAt: Long? = null,
+)
+
+/**
+ * 扫描工作日志中的单个文件处理结果。
+ * 状态 done 的条目会在续扫时直接跳过，不再下载也不再读标签。
+ */
+@Entity(
+    tableName = "scan_journal_items",
+    indices = [Index("journalId", "uri", unique = true), Index("status")]
+)
+data class ScanJournalItemEntity(
+    @PrimaryKey(autoGenerate = true)
+    val id: Long = 0,
+
+    val journalId: String,
+
+    val uri: String,
+
+    val fileName: String,
+
+    val folderId: Long,
+
+    /** done / failed / skipped */
+    val status: String,
+
+    val message: String? = null,
+
+    val updatedAt: Long = System.currentTimeMillis(),
+)
+
+object ScanJournalStatus {
+    const val RUNNING = "RUNNING"
+    const val PAUSED = "PAUSED"
+    const val FINISHED = "FINISHED"
+    const val FAILED = "FAILED"
+}
+
+object ScanJournalItemStatus {
+    const val DONE = "done"
+    const val FAILED = "failed"
+    const val SKIPPED = "skipped"
+}
