index 0000000..466ff65
--- /dev/null
+++ b/lyrico-app/src/main/java/com/lonx/lyrico/viewmodel/WebDavSetupViewModel.kt
@@ -0,0 +1,170 @@
+package com.lonx.lyrico.viewmodel
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.lonx.lyrico.data.webdav.WebDavClient
+import com.lonx.lyrico.data.webdav.WebDavClientFactory
+import com.lonx.lyrico.data.webdav.WebDavConfig
+import com.lonx.lyrico.data.webdav.WebDavConfigStore
+import com.lonx.lyrico.data.webdav.WebDavEntry
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+data class WebDavSetupUiState(
+    val serverUrl: String = "",
+    val userName: String = "",
+    val password: String = "",
+    /** 正在浏览的目录，相对连接根。 */
+    val browsePath: String = "",
+    val entries: List<WebDavEntry> = emptyList(),
+    val isLoading: Boolean = false,
+    val statusMessage: String? = null,
+    val isError: Boolean = false,
+    /** 已验证通过的连接 id。 */
+    val connectionId: String? = null,
+) {
+    val canConnect: Boolean get() = serverUrl.isNotBlank() && !isLoading
+}
+
+data class SavedWebDavFolder(
+    val connectionId: String,
+    val basePath: String,
+    val displayPath: String,
+)
+
+/**
+ * WebDAV 添加向导：填连接 → 测试并浏览目录 → 选定目录交给库扫描。
+ *
+ * 这里只列目录不列音频文件：真正扫描时才遍历音频，
+ * 避免在配置界面就把整个音乐库的文件全拉一遍。
+ * 连接凭据在确认前只存在内存里，点“添加”才写入本地配置。
+ */
+class WebDavSetupViewModel(
+    private val store: WebDavConfigStore,
+    private val factory: WebDavClientFactory,
+) : ViewModel() {
+
+    private val _state = MutableStateFlow(WebDavSetupUiState())
+    val state: StateFlow<WebDavSetupUiState> = _state.asStateFlow()
+
+    private val entryOrder = compareByDescending<WebDavEntry> { it.isDirectory }
+        .thenBy { it.name.lowercase() }
+
+    fun updateServerUrl(value: String) = _state.update { it.copy(serverUrl = value.trim()) }
+    fun updateUserName(value: String) = _state.update { it.copy(userName = value.trim()) }
+    fun updatePassword(value: String) = _state.update { it.copy(password = value) }
+
+    fun connect() {
+        val current = _state.value
+        if (!current.canConnect) return
+        if (!WebDavClient.isValidUrl(current.serverUrl)) {
+            _state.update { it.copy(statusMessage = "服务器地址格式不正确", isError = true) }
+            return
+        }
+        viewModelScope.launch {
+            _state.update { it.copy(isLoading = true, statusMessage = "正在连接…", isError = false) }
+            try {
+                val config = WebDavConfig(
+                    id = current.connectionId ?: store.newId(),
+                    serverUrl = current.serverUrl,
+                    userName = current.userName,
+                    password = current.password,
+                    basePath = "/",
+                )
+                val client = factory.byConfig(config)
+                client.resolveRootPath()
+                val entries = client.propfind("", depth = 1)
+                _state.update {
+                    it.copy(
+                        isLoading = false,
+                        connectionId = config.id,
+                        browsePath = "",
+                        entries = entries.sortedWith(entryOrder),
+                        statusMessage = "已连接，共 ${entries.count { e -> e.isDirectory }} 个目录",
+                        isError = false,
+                    )
+                }
+            } catch (e: Exception) {
+                _state.update { it.copy(isLoading = false, statusMessage = describe(e), isError = true) }
+            }
+        }
+    }
+
+    fun openDirectory(path: String) {
+        val current = _state.value
+        val connectionId = current.connectionId ?: return
+        viewModelScope.launch {
+            _state.update { it.copy(isLoading = true, statusMessage = null) }
+            try {
+                val client = factory.byConfig(
+                    WebDavConfig(
+                        id = connectionId,
+                        serverUrl = current.serverUrl,
+                        userName = current.userName,
+                        password = current.password,
+                    )
+                )
+                val entries = client.propfind(path, depth = 1)
+                _state.update {
+                    it.copy(
+                        isLoading = false,
+                        browsePath = path,
+                        entries = entries.filter { entry -> entry.isDirectory }.sortedWith(entryOrder),
+                    )
+                }
+            } catch (e: Exception) {
+                _state.update { it.copy(isLoading = false, statusMessage = describe(e), isError = true) }
+            }
+        }
+    }
+
+    fun goUp() {
+        val path = _state.value.browsePath
+        if (path.isEmpty()) return
+        openDirectory(path.substringBeforeLast('/', missingDelimiterValue = ""))
+    }
+
+    /** 保存连接并返回待注册的根目录；凭据缺失时返回 null 并提示。 */
+    fun saveConnection(): SavedWebDavFolder? {
+        val current = _state.value
+        val connectionId = current.connectionId
+        if (connectionId == null) {
+            _state.update { it.copy(statusMessage = "请先测试连接", isError = true) }
+            return null
+        }
+        val config = store.save(
+            WebDavConfig(
+                id = connectionId,
+                serverUrl = current.serverUrl,
+                userName = current.userName,
+                password = current.password,
+                basePath = "/",
+            )
+        )
+        val basePath = current.browsePath
+        return SavedWebDavFolder(
+            connectionId = config.id,
+            basePath = basePath,
+            displayPath = buildDisplayPath(config.serverUrl, basePath),
+        )
+    }
+
+    private fun buildDisplayPath(serverUrl: String, path: String): String {
+        val host = runCatching {
+            java.net.URI(if (serverUrl.contains("://")) serverUrl else "https://$serverUrl").host
+        }.getOrNull() ?: serverUrl
+        val trimmed = path.trim('/')
+        return if (trimmed.isEmpty()) "webdav://$host" else "webdav://$host/$trimmed"
+    }
+
+    private fun describe(e: Exception): String = when (e) {
+        is com.lonx.lyrico.data.webdav.WebDavException -> e.message ?: "连接失败"
+        is java.net.UnknownHostException -> "无法解析服务器地址"
+        is java.net.SocketTimeoutException -> "连接超时，请检查地址与网络"
+        is javax.net.ssl.SSLException -> "TLS 握手失败，请确认端口与证书"
+        else -> e.message ?: e::class.java.simpleName
+    }
+}
