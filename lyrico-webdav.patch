index 0000000..94a0b98
--- /dev/null
+++ b/lyrico-app/src/main/java/com/lonx/lyrico/data/webdav/WebDavClient.kt
@@ -0,0 +1,497 @@
+package com.lonx.lyrico.data.webdav
+
+import android.util.Log
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import okhttp3.Credentials
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody
+import okhttp3.RequestBody.Companion.asRequestBody
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.Response
+import org.w3c.dom.Element
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+import java.io.UnsupportedEncodingException
+import java.net.URLEncoder
+import java.util.concurrent.TimeUnit
+import javax.xml.parsers.DocumentBuilderFactory
+
+/** 一个 WebDAV 远程文件/目录条目，路径为相对扫描根目录的路径（例如 "专辑/01.flac"）。 */
+data class WebDavEntry(
+    val relativePath: String,
+    val name: String,
+    val isDirectory: Boolean,
+    val size: Long = 0L,
+    val lastModified: Long = 0L,
+    /** 服务器上的绝对路径（不含前导 /），内部用于映射回相对路径。 */
+    val absolutePath: String = "",
+)
+
+class WebDavException(message: String, val code: Int, val url: String? = null) : IOException(message)
+
+/**
+ * 极简 WebDAV 客户端。只实现 Lyrico 需要的动作：
+ * PROPFIND 枚举、GET 完整下载、PUT 整体替换上传、DELETE、MOVE。
+ *
+ * 注意：标签写入走“下载 → 本地改 → PUT 回去”的整文件替换，不做 Range 分块写。
+ * 原因很简单：Range PUT 不是 WebDAV 标准能力（RFC 4918 没有部分写语义），
+ * 服务端实现五花八门，写坏文件的概率远高于收益。
+ */
+class WebDavClient(
+    serverUrl: String,
+    userName: String,
+    password: String,
+    private val basePath: String = "/",
+    private val timeoutSeconds: Long = 60L,
+) {
+    val baseUrl = normalizeBaseUrl(serverUrl)
+
+    private val authHeader: String? = if (userName.isNotBlank() || password.isNotBlank()) {
+        Credentials.basic(userName, password, Charsets.UTF_8)
+    } else {
+        null
+    }
+
+    private val client: OkHttpClient = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(timeoutSeconds, TimeUnit.SECONDS)
+        .writeTimeout(timeoutSeconds, TimeUnit.SECONDS)
+        .callTimeout(0, TimeUnit.MILLISECONDS)
+        .followRedirects(true)
+        .followSslRedirects(true)
+        .retryOnConnectionFailure(true)
+        .build()
+
+    private val rootMutex = Mutex()
+
+    @Volatile
+    private var rootPathCache: String? = null
+
+    /** 扫描根目录（服务器上的绝对路径，始终以 / 开头、不以 / 结尾，根目录为 ""）。 */
+    suspend fun resolveRootPath(): String {
+        rootPathCache?.let { return it }
+        return rootMutex.withLock {
+            rootPathCache ?: run {
+                val resolved = if (basePath.isBlank() || basePath == "/") {
+                    ""
+                } else {
+                    canonicalPath(basePath.removePrefix("/").trimEnd('/'))
+                }
+                rootPathCache = resolved
+                resolved
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------- 枚举
+
+    override fun toString(): String = "WebDavClient($baseUrl)"
+
+    suspend fun propfind(relativeDir: String, depth: Int = 1): List<WebDavEntry> = withContext(Dispatchers.IO) {
+        // 注意：这里不能调用 resolveRootPath()，否则 canonicalPath() 的逐级探测会递归死锁。
+        val requested = normalizeRelative(relativeDir)
+        val target = resolveRootPath().let { root -> if (root.isEmpty()) requested else if (requested.isEmpty()) root else "$root/$requested" }
+        val url = buildUrlAbsolute(target, directory = true)
+        val requestBody = REQUEST_ALL.toRequestBody(MEDIA_TYPE_XML)
+        val request = authorized(Request.Builder().url(url).method("PROPFIND", requestBody))
+            .header("Depth", depth.toString())
+            .build()
+
+        val entries = executeWithAuthRetry(request) { response ->
+            if (response.code != 207 && !response.isSuccessful) {
+                throw WebDavException("PROPFIND 失败：HTTP ${response.code}", response.code, url)
+            }
+            val xml = response.peekBody(PROPFIND_BODY_LIMIT)?.bytes() ?: ByteArray(0)
+            parseMultiStatus(xml)
+        }
+
+        val prefix = if (target.isEmpty()) "" else "$target/"
+        entries.mapNotNull { raw ->
+            val normalized = raw.absolutePath.trim('/')
+            if (normalized.isEmpty()) return@mapNotNull null
+            // target 是 serverBasePath + 请求目录，按它切成相对路径即可。
+            val relative = when {
+                prefix.isNotEmpty() && normalized.startsWith(prefix) -> normalized.removePrefix(prefix)
+                normalized == target -> "" // 自身，丢弃
+                else -> normalized
+            }
+            if (relative.isEmpty()) null
+            else raw.copy(relativePath = relative, absolutePath = normalized)
+        }
+    }
+
+    /**
+     * 仅用于探测根路径是否存在且可访问。
+     */
+    /** 探测服务器上某个绝对路径（不含前导 /）是否为可访问目录。 */
+    suspend fun probe(absolutePath: String): Boolean = withContext(Dispatchers.IO) {
+        val url = buildUrlAbsolute(absolutePath, directory = true)
+        val request = authorized(
+            Request.Builder().url(url).method("PROPFIND", REQUEST_ALL.toRequestBody(MEDIA_TYPE_XML))
+        ).header("Depth", "0").build()
+        try {
+            executeWithAuthRetry(request) { response ->
+                when {
+                    response.code == 207 -> true
+                    response.code == 404 -> false
+                    else -> throw WebDavException("PROPFIND 失败：HTTP ${response.code}", response.code, url)
+                }
+            }
+        } catch (e: WebDavException) {
+            throw e
+        } catch (e: IOException) {
+            throw WebDavException("无法连接 WebDAV 服务器：${e.message}", 0, url)
+        }
+    }
+
+    /** 根目录是否存在（HTTP 404 表示不存在，其它错误抛出）。 */
+    suspend fun rootExists(): Boolean = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(root, directory = true)
+        val request = authorized(
+            Request.Builder().url(url).method("PROPFIND", REQUEST_ALL.toRequestBody(MEDIA_TYPE_XML))
+        ).header("Depth", "0").build()
+        executeWithAuthRetry(request) { response ->
+            when (response.code) {
+                207 -> true
+                404 -> false
+                401, 403 -> throw WebDavException("认证或权限不足：HTTP ${response.code}", response.code, url)
+                else -> throw WebDavException("WebDAV 请求失败：HTTP ${response.code}", response.code, url)
+            }
+        }
+    }
+
+    /** 下载整个文件到本地临时文件。 */
+    suspend fun download(relativePath: String, destination: File): Long = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(joinRelative(root, relativePath))
+        val request = authorized(Request.Builder().url(url).get()).build()
+        executeWithAuthRetry(request) { response ->
+            if (!response.isSuccessful) {
+                throw WebDavException("下载失败：HTTP ${response.code}", response.code, url)
+            }
+            val body = response.body ?: throw WebDavException("下载响应为空", response.code, url)
+            destination.parentFile?.mkdirs()
+            destination.outputStream().use { output ->
+                body.byteStream().use { input -> input.copyTo(output, DEFAULT_BUFFER_SIZE) }
+            }
+            destination.length()
+        }
+    }
+
+    /** 直接用 GET 流读取（不落地）。调用方负责关闭。 */
+    suspend fun openStream(relativePath: String): InputStream = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(joinRelative(root, relativePath))
+        val request = authorized(Request.Builder().url(url).get()).build()
+        val response = client.newCall(request).execute()
+        if (!response.isSuccessful) {
+            response.close()
+            throw WebDavException("读取失败：HTTP ${response.code}", response.code, url)
+        }
+        response.body?.byteStream() ?: throw WebDavException("读取响应为空", response.code, url)
+    }
+
+    /** 整体替换上传（PUT）。 */
+    suspend fun upload(relativePath: String, source: File, contentType: String? = null) = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(joinRelative(root, relativePath))
+        val mediaType = (contentType ?: guessMimeType(relativePath)).toMediaType()
+        uploadBody(relativePath, url, source.asRequestBody(mediaType))
+    }
+
+    suspend fun upload(relativePath: String, bytes: ByteArray, contentType: String? = null) = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(joinRelative(root, relativePath))
+        val mediaType = (contentType ?: guessMimeType(relativePath)).toMediaType()
+        uploadBody(relativePath, url, bytes.toRequestBody(mediaType))
+    }
+
+    private suspend fun uploadBody(relativePath: String, url: String, body: RequestBody) {
+        ensureDirectories(normalizeRelative(relativePath).substringBeforeLast('/', missingDelimiterValue = ""))
+        val request = authorized(Request.Builder().url(url).put(body)).build()
+        executeWithAuthRetry(request) { response ->
+            if (!response.isSuccessful) {
+                throw WebDavException("上传失败：HTTP ${response.code}", response.code, url)
+            }
+            response.code
+        }
+    }
+
+    suspend fun delete(relativePath: String, isDirectory: Boolean = false): Boolean = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(joinRelative(root, relativePath), directory = isDirectory)
+        val request = authorized(Request.Builder().url(url).delete()).build()
+        executeWithAuthRetry(request) { response ->
+            when {
+                response.isSuccessful -> true
+                response.code == 404 -> false
+                else -> throw WebDavException("删除失败：HTTP ${response.code}", response.code, url)
+            }
+        }
+    }
+
+    suspend fun move(sourceRelativePath: String, targetRelativePath: String, overwrite: Boolean = false): Boolean =
+        withContext(Dispatchers.IO) {
+            val root = resolveRootPath()
+            // 文件名可能变化，避免服务端因为缺少路径分段而困惑
+            val sourceUrl = buildUrlAbsolute(joinRelative(root, sourceRelativePath))
+            val targetUrl = buildUrlAbsolute(joinRelative(root, targetRelativePath))
+            val request = authorized(Request.Builder().url(sourceUrl).method("MOVE", EMPTY_BODY))
+                .header("Destination", targetUrl)
+                .header("Overwrite", if (overwrite) "T" else "F")
+                .build()
+            executeWithAuthRetry(request) { response ->
+                when {
+                    response.code == 201 || response.code == 204 -> true
+                    response.code == 412 -> false // 目标已存在且未允许覆盖
+                    response.isSuccessful -> true
+                    else -> throw WebDavException("重命名失败：HTTP ${response.code}", response.code, sourceUrl)
+                }
+            }
+        }
+
+    suspend fun exists(relativePath: String): Boolean = withContext(Dispatchers.IO) {
+        val root = resolveRootPath()
+        val url = buildUrlAbsolute(joinRelative(root, relativePath))
+        val request = authorized(Request.Builder().url(url).head()).build()
+        executeWithAuthRetry(request) { response ->
+            when (response.code) {
+                200 -> true
+                404, 405 -> false // 405：部分服务端不支持 HEAD，交给调用方按 PROPFIND 处理
+                else -> throw WebDavException("HEAD 失败：HTTP ${response.code}", response.code, url)
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------- 内部
+
+    private fun authorized(builder: Request.Builder): Request.Builder =
+        builder.apply {
+            header("User-Agent", "Lyrico-WebDAV/1.0")
+            authHeader?.let { header("Authorization", it) }
+        }
+
+    private suspend fun <T> executeWithAuthRetry(request: Request, handler: (Response) -> T): T {
+        // 响应体可能被 handler 消费；每次调用都持有独立 response，消费完由调用方/这里统一关闭。
+        var response = client.newCall(request).execute()
+        return try {
+            // 某些服务端不接受抢先式 Basic 认证（返回 401 + WWW-Authenticate），
+            // 重试一次即可，携带同样的 Authorization 头。
+            if (response.code == 401 && authHeader != null) {
+                response.close()
+                response = client.newCall(request).execute()
+            }
+            handler(response)
+        } finally {
+            response.close()
+        }
+    }
+
+    /** 逐级 MKCOL，已存在则忽略（301/405 表示已存在）。调用方传入相对于扫描根的目录。 */
+    private suspend fun ensureDirectories(relativeDir: String) {
+        val requested = normalizeRelative(relativeDir)
+        if (requested.isEmpty()) return
+        val target = joinRelative(resolveRootPath(), requested)
+        var current = ""
+        for (segment in target.split('/').filter { it.isNotBlank() }) {
+            current = if (current.isEmpty()) segment else "$current/$segment"
+            val url = buildUrlAbsolute(current, directory = true)
+            try {
+                val request = authorized(Request.Builder().url(url).method("MKCOL", EMPTY_BODY)).build()
+                client.newCall(request).execute().use { response ->
+                    if (response.code !in intArrayOf(200, 201, 204, 301, 405)) {
+                        Log.w(TAG, "MKCOL $current -> HTTP ${response.code}")
+                    }
+                }
+            } catch (e: IOException) {
+                Log.w(TAG, "MKCOL 失败: $current", e)
+            }
+        }
+    }
+
+    /**
+     * 把配置里的路径规范化成服务器上的真实大小写路径。
+     *
+     * 很多 WebDAV 服务（群晖、Nextcloud、Alist）路径大小写敏感，用户手输经常大小写不符；
+     * 这里逐级探测父目录，每次只多一次 Depth:0 请求，且只在第一次扫描时发生。
+     * 探测失败（例如没有父目录列目录权限）时按原样使用，不阻塞扫描。
+     */
+    private suspend fun canonicalPath(raw: String): String {
+        val segments = raw.split('/').filter { it.isNotBlank() }
+        if (segments.isEmpty()) return ""
+
+        var resolved = ""
+        for (segment in segments) {
+            val candidate = if (resolved.isEmpty()) segment else "$resolved/$segment"
+            val exactOk = runCatching { probe(candidate) }.getOrDefault(false)
+            if (exactOk) {
+                resolved = candidate
+                continue
+            }
+            val siblings = runCatching { propfind(resolved) }.getOrNull().orEmpty()
+            val matched = siblings.firstOrNull { it.name == segment }
+                ?: siblings.firstOrNull { it.name.equals(segment, ignoreCase = true) }
+            val actual = matched?.name ?: segment
+            resolved = if (resolved.isEmpty()) actual else "$resolved/$actual"
+        }
+        return resolved
+    }
+
+    fun buildUrlAbsolute(absolutePath: String, directory: Boolean = false): String {
+        val encoded = absolutePath.split('/').filter { it.isNotBlank() }
+            .joinToString("/") { encodePathSegment(it) }
+        val base = baseUrl.trimEnd('/')
+        return if (encoded.isEmpty()) "$base/" else "$base/$encoded" + if (directory) "/" else ""
+    }
+
+    /**
+     * 相对扫描根的路径 → 完整 URL。
+     * 这里刻意不读取根路径缓存：baseUrl 已经是用户配置的服务器根，相对路径直接拼即可。
+     */
+    fun buildUrl(relativePath: String, directory: Boolean = false): String =
+        buildUrlAbsolute(normalizeRelative(relativePath), directory)
+
+    private fun parseMultiStatus(xml: ByteArray): List<WebDavEntry> {
+        if (xml.isEmpty()) return emptyList()
+        return try {
+            val factory = DocumentBuilderFactory.newInstance().apply {
+                isNamespaceAware = true
+                setFeature("http://apache.org/xml/features/disallow-doctype-decl", true)
+                isExpandEntityReferences = false
+            }
+            val document = factory.newDocumentBuilder().parse(xml.inputStream())
+            val responses = document.getElementsByTagNameNS("*", "response")
+            val result = mutableListOf<WebDavEntry>()
+            for (i in 0 until responses.length) {
+                val response = responses.item(i) as? Element ?: continue
+                val href = response.textOfFirst("href") ?: continue
+                val prop = firstElement(response, "prop") ?: response
+                val isCollection = firstElement(prop, "resourcetype")
+                    ?.let { firstElement(it, "collection") } != null
+                val name = decodeHrefName(href)
+                val size = prop.textOfFirst("getcontentlength")?.toLongOrNull() ?: 0L
+                val modified = prop.textOfFirst("getlastmodified")?.let(::parseHttpDate) ?: 0L
+                result += WebDavEntry(
+                    relativePath = "",
+                    name = name,
+                    isDirectory = isCollection,
+                    size = size,
+                    lastModified = modified,
+                    absolutePath = hrefToAbsolutePath(href),
+                )
+            }
+            result
+        } catch (e: Exception) {
+            Log.w(TAG, "解析 PROPFIND 响应失败", e)
+            throw WebDavException("解析服务器响应失败：${e.message}", 207)
+        }
+    }
+
+    /** 把 href（可能是绝对 URL 或绝对路径）转换成服务器绝对路径（不含前导 /）。 */
+    fun hrefToAbsolutePath(href: String): String {
+        val decoded = runCatching { java.net.URI(href).path }.getOrNull() ?: href
+        val basePathPart = runCatching { java.net.URI(baseUrl).path }.getOrNull().orEmpty().trimEnd('/')
+        val withoutBase = if (basePathPart.isNotEmpty() && decoded.startsWith(basePathPart)) {
+            decoded.removePrefix(basePathPart)
+        } else {
+            decoded
+        }
+        return decodePath(withoutBase).trim('/')
+    }
+
+    private fun Element.textOfFirst(tag: String): String? =
+        firstElement(this, tag)?.textContent?.trim()?.takeIf { it.isNotEmpty() }
+
+    private fun firstElement(parent: Element, tag: String): Element? {
+        val byNs = parent.getElementsByTagNameNS("*", tag)
+        if (byNs.length > 0) return byNs.item(0) as? Element
+        val byName = parent.getElementsByTagName(tag)
+        return if (byName.length > 0) byName.item(0) as? Element else null
+    }
+
+    private fun decodeHrefName(href: String): String {
+        val path = runCatching { java.net.URI(href).path }.getOrNull() ?: href
+        val trimmed = path.trimEnd('/')
+        return decodePath(trimmed.substringAfterLast('/'))
+    }
+
+    companion object {
+        private const val TAG = "WebDavClient"
+        private const val REQUEST_ALL = """<?xml version="1.0" encoding="utf-8"?>
+<d:propfind xmlns:d="DAV:">
+  <d:prop>
+    <d:resourcetype/>
+    <d:getcontentlength/>
+    <d:getlastmodified/>
+  </d:prop>
+</d:propfind>"""
+        private val MEDIA_TYPE_XML = "application/xml; charset=utf-8".toMediaType()
+        private const val PROPFIND_BODY_LIMIT = 64L * 1024 * 1024
+        private val EMPTY_BODY = ByteArray(0).toRequestBody(null)
+
+        val AUDIO_EXTENSIONS = setOf(
+            "mp3", "flac", "m4a", "ogg", "opus", "wav", "aac", "wma", "ape",
+        )
+
+        fun normalizeBaseUrl(raw: String): String {
+            var url = raw.trim()
+            if (!url.contains("://")) url = "https://$url"
+            url = url.trimEnd('/')
+            return if (url.endsWith("/dav") || url.endsWith(".php")) url else url
+        }
+
+        fun normalizeRelative(path: String): String =
+            path.replace('\\', '/').trim().trim('/').split('/').filter { it.isNotBlank() }.joinToString("/")
+
+        fun joinRelative(root: String, relative: String): String {
+            val r = normalizeRelative(relative)
+            return if (root.isEmpty()) r else if (r.isEmpty()) root else "$root/$r"
+        }
+
+        fun isAudioFile(name: String): Boolean =
+            name.substringAfterLast('.', "").lowercase() in AUDIO_EXTENSIONS
+
+        fun encodePathSegment(segment: String): String = try {
+            URLEncoder.encode(segment, "UTF-8").replace("+", "%20")
+        } catch (e: UnsupportedEncodingException) {
+            segment
+        }
+
+        fun decodePath(path: String): String = try {
+            java.net.URLDecoder.decode(path, "UTF-8")
+        } catch (e: Exception) {
+            path
+        }
+
+        fun guessMimeType(name: String): String = when (name.substringAfterLast('.', "").lowercase()) {
+            "mp3" -> "audio/mpeg"
+            "flac" -> "audio/flac"
+            "m4a", "aac" -> "audio/mp4"
+            "ogg", "opus" -> "audio/ogg"
+            "wav" -> "audio/wav"
+            "wma" -> "audio/x-ms-wma"
+            "ape" -> "audio/x-ape"
+            else -> "application/octet-stream"
+        }
+
+        fun parseHttpDate(value: String): Long = runCatching {
+            val format = java.text.SimpleDateFormat("EEE, dd MMM yyyy HH:mm:ss zzz", java.util.Locale.US)
+            format.timeZone = java.util.TimeZone.getTimeZone("GMT")
+            format.parse(value)?.time ?: 0L
+        }.getOrDefault(0L)
+
+        /** 供 UI 使用：判断一个字符串是否是合法的 WebDAV 地址。 */
+        fun isValidUrl(raw: String): Boolean {
+            val candidate = if (raw.contains("://")) raw.trim() else "https://${raw.trim()}"
+            return candidate.toHttpUrlOrNull() != null
+        }
+    }
+}
