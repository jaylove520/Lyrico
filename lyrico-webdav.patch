+package com.lonx.lyrico.data.webdav
+
+import android.util.Log
+import java.io.File
+import java.io.FileNotFoundException
+
+/**
+ * 远程文件操作门面：删除、MOVE 重命名、把本地改好的文件 PUT 回去。
+ * 所有路径都是相对扫描根的路径。
+ */
+class WebDavFileOperations(private val clientFactory: WebDavClientFactory) {
+
+    suspend fun delete(uriString: String): Boolean {
+        val (client, relativePath) = clientFactory.resolve(uriString)
+            ?: throw FileNotFoundException("WebDAV 连接不存在或已删除: $uriString")
+        return client.delete(relativePath)
+    }
+
+    /** 返回新的文件 uri；目标已存在时返回 null（与 SAF 重命名的“名称冲突”语义一致）。 */
+    suspend fun rename(uriString: String, newFileName: String): String? {
+        val (client, relativePath) = clientFactory.resolve(uriString)
+            ?: throw FileNotFoundException("WebDAV 连接不存在或已删除: $uriString")
+        val parent = relativePath.substringBeforeLast('/', missingDelimiterValue = "")
+        val target = if (parent.isEmpty()) newFileName else "$parent/$newFileName"
+        val moved = client.move(relativePath, target, overwrite = false)
+        if (!moved) return null
+        val connectionId = WebDavUri.parseFileUri(uriString)?.connectionId ?: return null
+        return WebDavUri.buildFileUri(connectionId, target)
+    }
+
+    /** 整体替换上传。source 为本地修改后的临时文件。 */
+    suspend fun upload(uriString: String, source: File) {
+        val (client, relativePath) = clientFactory.resolve(uriString)
+            ?: throw FileNotFoundException("WebDAV 连接不存在或已删除: $uriString")
+        client.upload(relativePath, source)
+    }
+
+    suspend fun exists(uriString: String): Boolean {
+        val (client, relativePath) = clientFactory.resolve(uriString) ?: return false
+        return try {
+            client.exists(relativePath)
+        } catch (e: Exception) {
+            if (e is kotlinx.coroutines.CancellationException) throw e
+            Log.w(TAG, "WebDAV HEAD 失败: $uriString", e)
+            false
+        }
+    }
+
+    private companion object {
+        const val TAG = "WebDavFileOperations"
+    }
+}
