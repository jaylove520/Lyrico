+ *
+ * 远程库扫描一次可能要几十分钟。没有日志时，用户中途退出或断网就只能从头再来，
+ * 已下载解析的标签全部作废。这里把“哪些文件已经处理完”落到数据库，
+ * 应用重启后可以直接从中断处继续，并把已完成的条目逐条回显给进度条，
+ * 让用户看到“续上了”而不是“又从头开始”。
+ *
+ * 设计要点：
+ * - 每个文件处理完立刻写一条 item（done/failed/skipped），不依赖批量提交；
+ * - journal 行的进度字段随处理推进更新，崩溃后最后一次进度仍可恢复；
+ * - 扫描被取消时不删日志，标 PAUSED，下次可继续；
+ * - 只保留最近若干条已结束日志，避免无限增长。
+ */
+class ScanJournalRecorder(
+    private val dao: ScanJournalDao,
+    private val fullRescan: Boolean,
+    private val scopeFolderIds: Set<Long>?,
+) {
+    private var journalIdValue: String = UUID.randomUUID().toString()
+    private var inserted = 0
+    private var updated = 0
+    private var failed = 0
+    private var skipped = 0
+    private var processed = 0
+    private var total = -1
+    private val completedUris = mutableSetOf<String>()
+
+    val journalId: String get() = journalIdValue
+
+    /** 本期刊是否已完成过某个 uri（续扫时用于跳过）。 */
+    fun isAlreadyDone(uri: String): Boolean = uri in completedUris
+
+    suspend fun start(): String {
+        val resumable = dao.getResumableJournal()
+        if (resumable != null && resumable.fullRescan == fullRescan && resumable.scopeFolderIds == scopeKey()) {
+            // 结构完全一致的工作可以直接续上
+            journalIdValue = resumable.journalId
+            inserted = resumable.insertedCount
+            updated = resumable.updatedCount
+            failed = resumable.failedCount
+            skipped = resumable.skippedCount
+            processed = resumable.processedFiles
+            total = resumable.totalFiles
+            completedUris += dao.getCompletedUris(resumable.journalId)
+            dao.updateStatus(resumable.journalId, ScanJournalStatus.RUNNING)
+        } else {
+            daoSafe { dao.markAllRunningAsPaused() }
+            dao.upsertJournal(
+                ScanJournalEntity(
+                    journalId = journalIdValue,
+                    scopeFolderIds = scopeKey(),
+                    status = ScanJournalStatus.RUNNING,
+                    fullRescan = fullRescan,
+                )
+            )
+        }
+        return journalIdValue
+    }
+
+    suspend fun setTotal(count: Int) {
+        total = count
+        persist(null, null)
+    }
+
+    suspend fun recordDone(uri: String, fileName: String, folderId: Long, isInsert: Boolean) {
+        processed++
+        if (isInsert) inserted++ else updated++
+        completedUris += uri
+        dao.upsertItem(
+            ScanJournalItemEntity(
+                journalId = journalIdValue, uri = uri, fileName = fileName,
+                folderId = folderId, status = ScanJournalItemStatus.DONE,
+            )
+        )
+    }
+
+    suspend fun recordFailed(uri: String, fileName: String, folderId: Long, message: String?) {
+        processed++
+        failed++
+        dao.upsertItem(
+            ScanJournalItemEntity(
+                journalId = journalIdValue, uri = uri, fileName = fileName,
+                folderId = folderId, status = ScanJournalItemStatus.FAILED, message = message,
+            )
+        )
+    }
+
+    suspend fun recordSkipped(uri: String, fileName: String, folderId: Long, message: String?) {
+        processed++
+        skipped++
+        dao.upsertItem(
+            ScanJournalItemEntity(
+                journalId = journalIdValue, uri = uri, fileName = fileName,
+                folderId = folderId, status = ScanJournalItemStatus.SKIPPED, message = message,
+            )
+        )
+    }
+
+    /** 周期性调用（例如每 20 个文件）刷新进度，避免每个文件都写一行 journal。 */
+    suspend fun checkpoint(stage: String?, currentFile: String?) {
+        persist(stage, currentFile)
+    }
+
+    suspend fun finish() {
+        persist(null, null)
+        dao.updateStatus(journalIdValue, ScanJournalStatus.FINISHED, finishedAt = System.currentTimeMillis())
+        daoSafe { dao.pruneOldJournals() }
+    }
+
+    suspend fun pause(reason: String? = null) {
+        persist(null, null)
+        dao.updateStatus(journalIdValue, ScanJournalStatus.PAUSED, error = reason)
+    }
+
+    suspend fun fail(error: String) {
+        dao.updateStatus(journalIdValue, ScanJournalStatus.FAILED, error = error, finishedAt = System.currentTimeMillis())
+    }
+
+    val processedCount: Int get() = processed
+
+    private suspend fun persist(stage: String?, currentFile: String?) {
+        dao.updateProgress(
+            journalId = journalIdValue,
+            totalFiles = total,
+            processed = processed,
+            inserted = inserted,
+            updated = updated,
+            failed = failed,
+            skipped = skipped,
+            stage = stage,
+            currentFile = currentFile,
+        )
+    }
+
+    private fun scopeKey(): String? = scopeFolderIds?.sorted()?.joinToString(",")
+
+    private inline fun daoSafe(block: () -> Unit) {
+        runCatching(block)
+    }
+}
