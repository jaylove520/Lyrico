+package com.lonx.lyrico.data.song.file
+
+import android.os.ParcelFileDescriptor
+import android.util.Log
+import com.lonx.lyrico.data.webdav.WebDavClient
+import com.lonx.lyrico.data.webdav.WebDavClientFactory
+import java.io.File
+import java.io.FileNotFoundException
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * 把远程 WebDAV 文件映射为可读写的本地临时文件。
+ *
+ * 标签读写链路（TagLib）只接受 ParcelFileDescriptor，所以这里把远程文件整体下载到
+ * 应用缓存目录再交给 TagLib 处理；写完后由 upload 把改动整体 PUT 回服务器。
+ * 每次打开都会重新下载，保证拿到的是服务器上的最新内容。
+ *
+ * 缓存文件生命周期：read 打开时创建，描述符关闭后由 release 删除；
+ * 万一进程被杀死，下次启动由 [clearStaleCache] 清理。
+ */
+class WebDavFileBridge(private val clientFactory: WebDavClientFactory) {
+
+    private class Handle(
+        val cacheFile: File,
+        val client: WebDavClient,
+        val relativePath: String,
+        val initialSize: Long,
+        val initialModified: Long,
+    ) {
+        fun isModified(): Boolean =
+            cacheFile.length() != initialSize || cacheFile.lastModified() != initialModified
+    }
+
+    private val handles = ConcurrentHashMap<Int, Handle>()
+
+    fun resolve(uriString: String): Pair<WebDavClient, String>? = clientFactory.resolve(uriString)
+
+    fun openReadable(uriString: String, cacheDir: File): ParcelFileDescriptor {
+        val (client, relativePath) = resolve(uriString)
+            ?: throw FileNotFoundException("WebDAV 连接不存在或已删除: $uriString")
+        val cacheFile = newCacheFile(cacheDir, relativePath)
+        downloadWithRetry(client, relativePath, cacheFile)
+        val descriptor = try {
+            ParcelFileDescriptor.open(cacheFile, ParcelFileDescriptor.MODE_READ_ONLY)
+        } catch (e: Exception) {
+            cacheFile.delete()
+            throw e
+        }
+        handles[descriptor.fd] = Handle(
+            cacheFile = cacheFile,
+            client = client,
+            relativePath = relativePath,
+            initialSize = cacheFile.length(),
+            initialModified = cacheFile.lastModified(),
+        )
+        return descriptor
+    }
+
+    fun openWritable(uriString: String, cacheDir: File): ParcelFileDescriptor {
+        val (client, relativePath) = resolve(uriString)
+            ?: throw FileNotFoundException("WebDAV 连接不存在或已删除: $uriString")
+        val cacheFile = newCacheFile(cacheDir, relativePath)
+        downloadWithRetry(client, relativePath, cacheFile)
+        val descriptor = try {
+            ParcelFileDescriptor.open(cacheFile, ParcelFileDescriptor.MODE_READ_WRITE)
+        } catch (e: Exception) {
+            cacheFile.delete()
+            throw e
+        }
+        handles[descriptor.fd] = Handle(
+            cacheFile = cacheFile,
+            client = client,
+            relativePath = relativePath,
+            initialSize = cacheFile.length(),
+            initialModified = cacheFile.lastModified(),
+        )
+        return descriptor
+    }
+
+    /** 把本地改动整体 PUT 回服务器。返回 true 表示确实上传了内容。 */
+    suspend fun upload(uriString: String, source: File): Boolean {
+        val (client, relativePath) = resolve(uriString) ?: throw FileNotFoundException(uriString)
+        client.upload(relativePath, source)
+        return true
+    }
+
+    /**
+     * 提交某个描述符对应的缓存文件改动。返回 true 表示发生了上传。
+     * 只对仍持有句柄的文件有效（通常紧接着写入之后调用）。
+     */
+    suspend fun commitHandle(descriptor: ParcelFileDescriptor): Boolean {
+        val handle = handles[descriptor.fd] ?: return false
+        if (!handle.isModified()) return false
+        handle.client.upload(handle.relativePath, handle.cacheFile)
+        return true
+    }
+
+    fun release(descriptor: ParcelFileDescriptor) {
+        val handle = handles.remove(descriptor.fd) ?: return
+        try {
+            descriptor.close()
+        } catch (e: Exception) {
+            Log.w(TAG, "关闭 WebDAV 描述符失败", e)
+        }
+        try {
+            if (!handle.cacheFile.delete()) {
+                Log.w(TAG, "删除 WebDAV 缓存失败: ${handle.cacheFile.absolutePath}")
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "删除 WebDAV 缓存异常", e)
+        }
+    }
+
+    /** 应用启动时清理上次遗留的缓存（描述符已失效）。 */
+    fun clearStaleCache(cacheDir: File) {
+        val dir = File(cacheDir, CACHE_SUBDIR)
+        if (!dir.exists()) return
+        dir.listFiles()?.forEach { file ->
+            runCatching { file.delete() }
+        }
+    }
+
+    private fun downloadWithRetry(client: WebDavClient, relativePath: String, cacheFile: File) {
+        var lastError: Exception? = null
+        for (attempt in 1..MAX_ATTEMPTS) {
+            try {
+                kotlinx.coroutines.runBlocking { client.download(relativePath, cacheFile) }
+                return
+            } catch (e: Exception) {
+                if (e is kotlinx.coroutines.CancellationException) throw e
+                lastError = e
+                Log.w(TAG, "WebDAV 下载失败（第 $attempt 次）: $relativePath", e)
+            }
+        }
+        cacheFile.delete()
+        throw lastError ?: FileNotFoundException(relativePath)
+    }
+
+    private fun newCacheFile(cacheDir: File, relativePath: String): File {
+        val dir = File(cacheDir, CACHE_SUBDIR).apply { mkdirs() }
+        val name = relativePath.substringAfterLast('/')
+        val extension = name.substringAfterLast('.', "tmp").take(8)
+        return File.createTempFile("wd-", ".$extension", dir)
+    }
+
+    private companion object {
+        const val TAG = "WebDavFileBridge"
+        const val CACHE_SUBDIR = "webdav-audio-cache"
+        const val MAX_ATTEMPTS = 2
+    }
+}
